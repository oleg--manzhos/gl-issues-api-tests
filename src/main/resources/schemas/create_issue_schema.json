{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "id",
    "iid",
    "project_id",
    "title",
    "description",
    "state",
    "created_at",
    "updated_at",
    "labels",
    "assignees",
    "author",
    "type",
    "user_notes_count",
    "merge_requests_count",
    "upvotes",
    "downvotes",
    "confidential",
    "issue_type",
    "web_url",
    "time_stats",
    "task_completion_status",
    "blocking_issues_count",
    "has_tasks",
    "task_status",
    "_links",
    "references",
    "severity",
    "imported",
    "imported_from"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minLength": 1
    },
    "iid": {
      "type": "integer",
      "minLength": 1
    },
    "project_id": {
      "type": "integer",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": ["string", "null"]
    },
    "state": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "closed_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "closed_by": {
      "type": ["object", "null"]
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "milestone": {
      "type": ["object", "null"]
    },
    "assignees": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "author": {
      "type": "object",
      "required": [
        "id",
        "username",
        "public_email",
        "name",
        "state",
        "locked",
        "avatar_url",
        "web_url"
      ],
      "properties": {
        "id": {
          "type": "integer"
        },
        "username": {
          "type": "string"
        },
        "public_email": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "locked": {
          "type": "boolean"
        },
        "avatar_url": {
          "type": ["string", "null"]
        },
        "web_url": {
          "type": "string"
        }
      }
    },
    "type": {
      "type": "string"
    },
    "assignee": {
      "type": ["object", "null"]
    },
    "user_notes_count": {
      "type": "integer"
    },
    "merge_requests_count": {
      "type": "integer"
    },
    "upvotes": {
      "type": "integer"
    },
    "downvotes": {
      "type": "integer"
    },
    "start_date": {
      "type": ["string", "null"]
    },
    "due_date": {
      "type": ["string", "null"]
    },
    "confidential": {
      "type": "boolean"
    },
    "discussion_locked": {
      "type": ["boolean", "null"]
    },
    "issue_type": {
      "type": "string"
    },
    "web_url": {
      "type": "string"
    },
    "time_stats": {
      "type": "object",
      "required": [
        "time_estimate",
        "total_time_spent",
        "human_time_estimate",
        "human_total_time_spent"
      ],
      "properties": {
        "time_estimate": {
          "type": "integer"
        },
        "total_time_spent": {
          "type": "integer"
        },
        "human_time_estimate": {
          "type": ["string", "null"]
        },
        "human_total_time_spent": {
          "type": ["string", "null"]
        }
      }
    },
    "task_completion_status": {
      "type": "object",
      "required": [
        "count",
        "completed_count"
      ],
      "properties": {
        "count": {
          "type": "integer"
        },
        "completed_count": {
          "type": "integer"
        }
      }
    },
    "blocking_issues_count": {
      "type": "integer"
    },
    "has_tasks": {
      "type": "boolean"
    },
    "task_status": {
      "type": "string"
    },
    "_links": {
      "type": "object",
      "required": [
        "self",
        "notes",
        "award_emoji",
        "project"
      ],
      "properties": {
        "self": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "award_emoji": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "closed_as_duplicate_of": {
          "type": ["string", "null"]
        }
      }
    },
    "references": {
      "type": "object",
      "required": [
        "short",
        "relative",
        "full"
      ],
      "properties": {
        "short": {
          "type": "string"
        },
        "relative": {
          "type": "string"
        },
        "full": {
          "type": "string"
        }
      }
    },
    "severity": {
      "type": "string"
    },
    "subscribed": {
      "type": "boolean"
    },
    "moved_to_id": {
      "type": ["integer", "null"]
    },
    "imported": {
      "type": "boolean"
    },
    "imported_from": {
      "type": "string"
    },
    "service_desk_reply_to": {
      "type": ["string", "null"]
    }
  }
}